# Prettier ignore — keep in sync with .gitignore build/output excludes.

# Dependencies and lockfile
node_modules/
pnpm-lock.yaml

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Playwright output (docs/TEST_PLAN.md §2.3)
apps/client/test-results/
apps/client/playwright-report/
apps/client/blob-report/

# Vite / caches
.vite/

# Supabase CLI local state (docs/DECISIONS.md D53). Prettier does not read
# .gitignore, so an ignored file is still a `format:check` failure until it is
# named here too — which is how supabase/.temp/linked-project.json failed the
# gate. supabase/migrations/*.sql is not Prettier's to format either: Prettier
# has no SQL parser, so it never opens those files.
supabase/.temp/
supabase/.branches/

# Environment files
.env
.env.*
!.env.example

# Generated design artifacts (excluded from lint, typecheck, and build per docs/DEVELOPMENT_RULES.md)
design-artifacts/

# Markdown is formatted by hand. The two authoritative docs in docs/ MUST NOT be
# reformatted, and the remaining docs use manual layout, so exclude all Markdown.
*.md
