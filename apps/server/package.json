{
  "name": "@carry-or-fall/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Colyseus game server (Node 24). M0 hosts a single foundation_room with a health endpoint and graceful shutdown; no gameplay.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node esbuild.config.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@carry-or-fall/protocol": "workspace:*",
    "@colyseus/core": "0.17.45",
    "@colyseus/schema": "4.0.30",
    "@colyseus/ws-transport": "0.17.13",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "tsx": "4.23.1"
  }
}
