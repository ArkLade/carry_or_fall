# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment files — never commit real secrets. Only .env.example is tracked.
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.vitest/
.nyc_output/

# Playwright (docs/TEST_PLAN.md §2.3): screenshots/traces from local/CI runs
# and the browser binaries `playwright install` downloads.
apps/client/test-results/
apps/client/playwright-report/
apps/client/blob-report/

# Vite / caches
.vite/

# Supabase CLI local state (docs/DECISIONS.md D53). `supabase link` writes the
# linked project ref and a version cache under supabase/.temp/, and branch state
# under supabase/.branches/. Both are per-developer state naming one project, not
# source. supabase/migrations/ and supabase/README.md stay tracked — they are the
# schema itself.
supabase/.temp/
supabase/.branches/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated design artifacts (excluded from lint, typecheck, and build per docs/DEVELOPMENT_RULES.md)
design-artifacts/
